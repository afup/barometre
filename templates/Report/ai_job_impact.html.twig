<table class="table table-striped highchart tablesorter"
       data-graph-container-before="1"
       data-graph-type="column"
       data-graph-legend-disabled="1"
       data-graph-inverted="1"
       data-graph-xaxis-labels-align="right">
    <thead>
    <tr>
        <th>{{ "report.ai_job_impact.label" | trans }}</th>
        <th class="text-right">{{ "report.view.response_number" | trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% for row in results %}
        <tr>
            <td>
                {{ row.aiJobImpact|enum_label('App\\Enums\\AiJobImpactEnums') }}
            </td>
            <td class="text-right">{{ row.nbResponse|number_format(null, '', ' ') }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
